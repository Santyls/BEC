# --- Secrets ---
.env
!.env.example

# --- Python (BEC_API, BEC_PRF, BEC_PCF) ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
*.sqlite3
.pytest_cache/

# --- PHP / Laravel (BEC_PAL, BEC_L) ---
vendor/
node_modules/
storage/*.key
*.log
.phpunit.result.cache

# --- Certificados / claves TLS (no deben versionarse) ---
*.pem
*.key
*.crt
*.csr
!BEC_API/**/*.crt.example

# --- Archivos subidos por usuarios en tiempo de ejecución ---
# Son fotos de perfil de personas reales: datos personales que no tienen por qué
# acabar en un repositorio público, y además se regeneran solas al usar la app.
BEC_API/uploads/

# --- Empaquetados temporales para desplegar ---
*.tar.gz

# --- Editores / SO / herramientas ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
