# Copia este archivo a ".env" (sin el .example) y rellena los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=bec_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=bec_db
POSTGRES_PORT=5432

# --- JWT (BEC_API) ---
# Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=cambia_esta_llave_por_una_generada_aleatoriamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Flask (BEC_PRF) — firma las cookies de sesión, no relacionada con SECRET_KEY ---
FLASK_SECRET_KEY=cambia_esta_llave_por_una_generada_aleatoriamente

# --- URL pública de BEC_API (para que el navegador cargue fotos/archivos servidos por la API) ---
BEC_API_PUBLIC_URL=http://localhost:8000

# --- Correo saliente (recuperar contraseña) ---
# Opcional: si se deja vacío, el código de recuperación se imprime en los logs de
# bec_api_app en vez de enviarse por correo (sirve para desarrollo/pruebas).
# Sirve con cualquier proveedor que ofrezca un relay SMTP, por ejemplo:
#   - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu_correo@gmail.com,
#     SMTP_PASSWORD=una "contraseña de aplicación" (no tu contraseña normal — se genera
#     en https://myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
#   - Brevo, Resend, Mailgun, etc. (todos ofrecen SMTP en su capa gratuita).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
