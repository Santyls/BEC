# Copia este archivo a ".env" (sin el .example) y rellena los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=bec_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=bec_db
POSTGRES_PORT=5432

# --- JWT (BEC_API) ---
# Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=cambia_esta_llave_por_una_generada_aleatoriamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
