{
  "uid": "bec-overview",
  "title": "BEC — Monitoreo del Proyecto",
  "tags": ["bec"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estado de los servicios",
      "description": "Cada backend detrás de HAProxy: 1 = arriba, 0 = caído.",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "haproxy_backend_status{proxy=~\"pal_back|prf_back|api_back\", state=\"UP\"}",
          "legendFormat": "{{proxy}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDO", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "ARRIBA", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peticiones por segundo",
      "description": "Tráfico HTTP total que está entrando por HAProxy.",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(haproxy_frontend_http_requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Bloqueadas (429)",
      "description": "Peticiones rechazadas por el límite anti-DDoS. Si esto se pone en rojo, alguien está atacando.",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(haproxy_frontend_requests_denied_total{proxy=~\"admin_front|recepcion_front|api_front\"}[5m]))",
          "legendFormat": "bloqueadas"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tráfico de red — entrada",
      "description": "Datos que ENTRAN al servidor privado (donde viven API, portales y BD).",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "entrada"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tráfico de red — salida",
      "description": "Datos que SALEN del servidor privado hacia el proxy/usuarios.",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "salida"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Balanceo de carga — respuestas por réplica de la API",
      "description": "Demuestra el balanceador: HAProxy reparte las peticiones entre api1, api2 y api3 con round-robin. Las 3 líneas deben moverse de forma pareja.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(server) (rate(haproxy_server_http_responses_total{proxy=\"api_back\"}[5m]))",
          "legendFormat": "{{server}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tráfico de red del servidor (entrada / salida)",
      "description": "Ancho de banda usado por la interfaz de red del servidor privado.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "entrada"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "salida"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Peticiones por portal",
      "description": "admin_front = portal Admin (443), recepcion_front = portal Recepción (8444), api_front = API móvil (8446).",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(proxy) (rate(haproxy_frontend_http_requests_total[5m]))",
          "legendFormat": "{{proxy}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tiempo de respuesta por servicio",
      "description": "Cuánto tarda cada backend en contestar. Si sube mucho, algo se está saturando.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "haproxy_backend_response_time_average_seconds{proxy=~\"pal_back|prf_back|api_back\"}",
          "legendFormat": "{{proxy}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Uso de CPU",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU usada"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Uso de memoria RAM",
      "description": "Ojo con este: el servidor privado tiene 1 GB y corre 8 contenedores.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM usada"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sesiones activas por servicio",
      "description": "Conexiones abiertas en cada momento — útil para ver picos de uso (o un ataque).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(proxy) (haproxy_server_current_sessions{proxy=~\"pal_back|prf_back|api_back\"})",
          "legendFormat": "{{proxy}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "🛡  Detección de ataques — peticiones bloqueadas",
      "description": "Cada pico = una IP que pasó el límite de 100 peticiones en 10 segundos y HAProxy la rechazó con 429. En uso normal esta gráfica está plana en cero.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(proxy) (rate(haproxy_frontend_requests_denied_total{proxy=~\"admin_front|recepcion_front|api_front\"}[1m]))",
          "legendFormat": "{{proxy}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": { "fillOpacity": 40, "lineWidth": 2, "showPoints": "never", "gradientMode": "opacity" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pico real de peticiones por segundo",
      "description": "Lo que mide HAProxy internamente, SIN promediar. Una ráfaga de 300 peticiones se ve aquí como un pico de ~50 req/s, mientras que en un promedio de 5 minutos quedaría aplastada en 1 req/s y se te pasaría de largo.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "bec-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "haproxy_frontend_http_requests_rate_max{proxy=~\"admin_front|recepcion_front|api_front\"}",
          "legendFormat": "{{proxy}} (pico)"
        },
        {
          "refId": "B",
          "expr": "sum by(proxy) (rate(haproxy_frontend_http_requests_total{proxy=~\"admin_front|recepcion_front|api_front\"}[1m]))",
          "legendFormat": "{{proxy}} (actual 1m)"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
