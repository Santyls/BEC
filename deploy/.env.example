# Copia a ".env" dentro de deploy/ en AMBOS droplets (público y privado usan
# el mismo archivo, aunque el público solo necesita GRAFANA_ADMIN_PASSWORD y
# STATS_PASSWORD de aquí — no pasa nada si le sobran variables).

# --- Postgres ---
POSTGRES_USER=bec_user
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=bec_db

# --- JWT (BEC_API) — puedes reusar los mismos valores de tu .env local ---
SECRET_KEY=cambia_esto
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Correo saliente (recuperar contraseña) — opcional, ver BEC_API/app/utils/email.py ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Flask (BEC_PRF) ---
FLASK_SECRET_KEY=cambia_esto

# --- URL pública de la API (para que el navegador cargue fotos/archivos) ---
# Reemplaza 24.144.123.16 por la IP pública real del droplet público.
BEC_API_PUBLIC_URL=https://24.144.123.16:8446

# --- Grafana + stats de HAProxy ---
GRAFANA_ADMIN_PASSWORD=cambia_esto
STATS_PASSWORD=cambia_esto
